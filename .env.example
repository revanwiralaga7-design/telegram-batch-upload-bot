# Ambil dari @BotFather
BOT_TOKEN=123456789:REPLACE_DENGAN_TOKEN_BOT

# ID chat/channel tujuan. Bisa angka seperti -1001234567890 atau @username_channel.
# Bot harus menjadi admin di channel/grup tujuan dan punya izin mengirim pesan.
TARGET_CHAT_ID=-1001234567890

# Opsional: batasi pemakai bot. Isi dengan user ID Telegram, pisahkan koma.
# Kosongkan agar semua pengguna boleh memakai bot (tidak disarankan untuk bot publik).
ALLOWED_USER_IDS=

# Opsional untuk mode upload file dari VPS.
# Bisa juga memberikan path langsung: npm run upload -- /path/ke/folder
UPLOAD_DIR=/home/user/files

# Opsional: catatan file yang sudah sukses diupload (mencegah upload ulang).
# STATE_FILE=/home/user/.telegram-upload-state.json

# Mode upload sebagai akun Telegram pribadi (userbot / MTProto).
# Buat di https://my.telegram.org/apps — BUKAN token dari BotFather.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# USER_SESSION_FILE=/home/user/.telegram-user.session
# USER_STATE_FILE=/home/user/.user-upload-state.json
